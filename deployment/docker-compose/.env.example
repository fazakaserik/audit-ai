# Copy to .env (never commit secrets).
# All variables map to backend.config.Settings (flat names, case-insensitive).

# --- LLM / embeddings ---------------------------------------------------------
# Chat model provider: ollama | openai
LLM_PROVIDER=ollama
# Chat model id for the chosen provider (e.g. qwen3.5:4b, gpt-4o-mini)
LLM_MODEL=qwen3.5:4b
# Embedding provider: ollama | openai (may differ from LLM_PROVIDER)
EMBEDDING_PROVIDER=ollama
# Embedding model id (e.g. nomic-embed-text, text-embedding-3-small)
EMBEDDING_MODEL=nomic-embed-text
# Ollama HTTP base URL. From compose containers use host.docker.internal to reach the host.
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Required when LLM_PROVIDER or EMBEDDING_PROVIDER is openai (leave empty for ollama-only).
OPENAI_API_KEY=

# OpenAI example (uncomment and set the key):
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_API_KEY=sk-...

# --- Data store ---------------------------------------------------------------
# Async SQLAlchemy URL (asyncpg). Compose overrides host to the postgres service.
DATABASE_URL=postgresql+asyncpg://audit:audit@postgres:5432/audit
# Directory for raw uploaded files (shared volume across api + upload-processor).
DOCUMENT_STORAGE_PATH=/data/storage

# --- Ask / RAG behaviour ------------------------------------------------------
# Per-call timeout (seconds) for chat and embedding HTTP requests.
MODEL_TIMEOUT_SECONDS=120
# Max chunks returned from hybrid retrieval per search.
RETRIEVAL_TOP_K=8
# Minimum relevance score for a retrieved chunk to count as usable evidence (0–1).
RELEVANCE_THRESHOLD=0.30
# Max in-flight model/embed calls per process (each api / upload-processor replica).
MAX_CONCURRENT_MODEL_CALLS=2
# Cap on agent tool-calling rounds before grading/generating an answer.
AGENT_MAX_TOOL_ROUNDS=6
# Max characters returned by the read_document tool into the agent context.
AGENT_READ_MAX_CHARS=12000

# --- Uploads ------------------------------------------------------------------
# Max total bytes for one multipart upload request.
UPLOAD_MAX_BYTES=52428800
# Max files accepted in one upload (including zip members after expansion).
UPLOAD_MAX_FILES=200
# Max bytes for a single file inside an upload.
UPLOAD_MAX_FILE_BYTES=20971520

# --- HTTP process (host `audit-api` / Settings.run only) ----------------------
# Bind address when running the API outside Compose (Compose Dockerfile uses 0.0.0.0:8000).
API_HOST=0.0.0.0
API_PORT=8000
# Expose /docs, /redoc, and /openapi.json (compose.dev also forces true).
ENABLE_API_DOCS=true

# --- Logging ------------------------------------------------------------------
# structlog level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# true = JSON lines (scrapers); false = human-readable (compose.dev sets false).
LOG_JSON=true
