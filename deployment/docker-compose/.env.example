# Copy to .env (never commit secrets)

# --- Local GPU (default): host Ollama with Qwen3.5 4B ---
# On the host: ollama pull qwen3.5:4b && ollama pull nomic-embed-text
# Ollama uses the GPU automatically when available.
LLM_PROVIDER=ollama
LLM_MODEL=qwen3.5:4b
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
OLLAMA_BASE_URL=http://host.docker.internal:11434

# --- Cloud alternative ---
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_API_KEY=

OPENAI_API_KEY=

DATABASE_URL=postgresql+asyncpg://audit:audit@postgres:5432/audit
DOCUMENT_STORAGE_PATH=/data/storage

MODEL_TIMEOUT_SECONDS=120
RETRIEVAL_TOP_K=8
RELEVANCE_THRESHOLD=0.30
MAX_CONCURRENT_MODEL_CALLS=2
SESSION_CONTEXT_TURNS=5

UPLOAD_MAX_BYTES=52428800
UPLOAD_MAX_FILES=200
UPLOAD_MAX_FILE_BYTES=20971520

API_HOST=0.0.0.0
API_PORT=8000
# Upload claim loop runs inside the API process (single container).
RUN_WORKER_IN_API=true
# Swagger/ReDoc/OpenAPI at /docs, /redoc, /openapi.json (compose.dev also forces true).
ENABLE_API_DOCS=true
# Logging — compose.dev sets LOG_JSON=false for readable console output.
LOG_LEVEL=INFO
LOG_JSON=true
