# Copy to .env (never commit secrets).
# All variables map to backend.config.Settings (flat names, case-insensitive).

# --- LLM / embeddings ---------------------------------------------------------
# LiteLLM chat model id: provider/model (any provider LiteLLM supports).
LLM_MODEL=ollama_chat/qwen3.5:4b
# Optional API key (required for non-ollama providers).
LLM_API_KEY=
# Optional API base (Ollama, Azure, proxies). From compose use host.docker.internal.
LLM_API_BASE=http://host.docker.internal:11434
# LiteLLM embedding model id (may use a different provider than chat).
EMBEDDING_MODEL=ollama/nomic-embed-text
# Optional; falls back to LLM_API_KEY when unset.
EMBEDDING_API_KEY=
# Optional; falls back to LLM_API_BASE when unset.
EMBEDDING_API_BASE=
# Optional override when the model is not in the known-dims table.
# EMBEDDING_DIMENSIONS=768
# Ollama chat context window (tokens). Applied only for ollama / ollama_chat models.
OLLAMA_NUM_CTX=32768

# OpenAI example (uncomment and set the key):
# LLM_MODEL=openai/gpt-6-luna
# LLM_API_KEY=sk-...
# LLM_API_BASE=
# EMBEDDING_MODEL=openai/text-embedding-3-small
# EMBEDDING_API_KEY=

# --- Data store ---------------------------------------------------------------
# Postgres credentials used by compose. Required — Compose has no silent fallback.
# Values below are local-demo only (loopback publish). Change before any broader exposure.
POSTGRES_USER=audit
POSTGRES_PASSWORD=audit
POSTGRES_DB=audit
# Async SQLAlchemy URL (asyncpg). Must match POSTGRES_* above.
DATABASE_URL=postgresql+asyncpg://audit:audit@postgres:5432/audit
# Directory for raw uploaded files (shared volume across api + upload-processor).
DOCUMENT_STORAGE_PATH=/data/storage

# --- Ask / RAG behaviour ------------------------------------------------------
# Per-call timeout (seconds) for chat and embedding HTTP requests.
MODEL_TIMEOUT_SECONDS=120
# Max chunks returned from hybrid retrieval per search.
RETRIEVAL_TOP_K=8
# Minimum relevance score for a retrieved chunk to count as usable evidence (0–1).
RELEVANCE_THRESHOLD=0.30
# Max in-flight model/embed calls per process (each api / upload-processor replica).
MAX_CONCURRENT_MODEL_CALLS=2
# Cap on agent tool-calling rounds before the model must answer without more tools.
AGENT_MAX_TOOL_ROUNDS=6
# Max times the evidence check may send the agent back to think (0 = no retries).
AGENT_MAX_CHECK_RESTARTS=2
# Max characters returned by the read_document tool into the agent context.
AGENT_READ_MAX_CHARS=12000
# Recent session turns kept verbatim in Ask prompts (older turns are summarized).
SESSION_CONTEXT_TURNS=5
# Max prior turns considered for Ask history prep (must be >= SESSION_CONTEXT_TURNS).
SESSION_MAX_TURNS=100
# Max characters of retrieved/read evidence text kept in the evidence bag for checks.
AGENT_EVIDENCE_MAX_CHARS=24000

# --- Uploads ------------------------------------------------------------------
# Max total bytes for one multipart upload request.
UPLOAD_MAX_BYTES=52428800
# Max files accepted in one upload (including zip members after expansion).
UPLOAD_MAX_FILES=200
# Max bytes for a single file inside an upload.
UPLOAD_MAX_FILE_BYTES=20971520
# Ingest representation ceilings (worker fail-closed).
INGEST_MAX_EXPANDED_CHARS=2000000
INGEST_MAX_PAGES=500
INGEST_MAX_CHUNKS=5000

# --- HTTP process (host `audit-api` / Settings.run only) ----------------------
# Bind address when running the API outside Compose (Compose Dockerfile uses 0.0.0.0:8000).
API_HOST=0.0.0.0
API_PORT=8000
# Expose /docs, /redoc, and /openapi.json (compose.dev also forces true).
ENABLE_API_DOCS=true

# --- Logging ------------------------------------------------------------------
# structlog level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# true = JSON lines (scrapers); false = human-readable (compose.dev sets false).
LOG_JSON=true
