{
  "include": [
    "services/backend/src",
    "services/backend/tests",
    "cli/src",
    "cli/tests",
    "scripts"
  ],
  "exclude": ["**/__pycache__", ".venv"],
  "venvPath": ".",
  "venv": ".venv",
  "pythonVersion": "3.13",
  "typeCheckingMode": "strict",
  "reportMissingImports": true,
  "reportAny": "error",
  "reportExplicitAny": "error",
  "extraPaths": [
    "services/backend/src",
    "services/backend/tests",
    "cli/src"
  ]
}
